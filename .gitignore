# --- build outputs -----------------------------------------------------------
# tools/make_anon_snapshot.sh writes build/anon/ here. NOTE: gitignore has no
# trailing comments -- a '#' after a pattern becomes part of the pattern.
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- environments ------------------------------------------------------------
.venv/
venv/
.env

# --- site-local configuration (never committed; *.example files are) ---------
cluster/site.env
tools/identity_denylist.local.txt

# --- fetched third-party code (setup/ scripts install these; not vendored) ---
external/*
!external/.gitkeep

# --- large inputs and run outputs --------------------------------------------
# Everything reproduce/ consumes lives in artifacts/ and IS committed. These are
# the upstream heavy inputs and raw run outputs, fetched or regenerated by script.
data/checkpoints/
data/raw/
runs/
wandb/

# NOTE: do NOT add per-file exceptions to this file. If an artifact is too large
# to commit, it belongs in the Zenodo deposit with a fetch script and a checksum
# in artifacts/MANIFEST.csv -- not in a one-off ignore rule. The previous repo
# accumulated a tail of these and silently lost a publication figure that way.
